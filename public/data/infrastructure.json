  "storylines": [
    {
      "id": "s-order-journey",
      "name": "How a customer order flows",
      "steps": [
        {
          "title": "Customers arrive",
          "caption": "Customers reach us through the web portal or the mobile app. Both call the same Orders API.",
          "view": "3d",
          "highlight": [
            "users",
            "portal",
            "mobile",
            "orders-api"
          ],
          "camera": null
        },
        {
          "title": "Through the perimeter",
          "caption": "Traffic comes in over two internet links, passes the firewall, and the load balancer terminates TLS.",
          "view": "iso",
          "highlight": [
            "rtr-edge",
            "fw-01",
            "lb-01"
          ],
          "camera": null
        },
        {
          "title": "Into the production cluster",
          "caption": "The load balancer forwards requests to the Kubernetes ingress, where the portal and the Orders API run.",
          "view": "iso",
          "highlight": [
            "lb-01",
            "k8s-prod",
            "portal",
            "orders-api"
          ],
          "camera": null
        },
        {
          "title": "Data and events",
          "caption": "Orders are written to PostgreSQL, sessions live in the cache, and order events go onto the queue for fulfilment.",
          "view": "iso",
          "highlight": [
            "k8s-prod",
            "db-orders",
            "cache-01",
            "mq-01",
            "s3-01"
          ],
          "camera": null
        },
        {
          "title": "Down to the hardware",
          "caption": "All of this runs on rack row A in Data centre 1, with storage on SAN-01 and power backed by UPS-01.",
          "view": "3d",
          "highlight": [
            "rack-a1",
            "rack-a2",
            "rack-a3",
            "san-01",
            "ups-01",
            "sw-core"
          ],
          "camera": null
        }
      ]
    }
  ]
